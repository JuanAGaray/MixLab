# Copiar a .env y completar valores reales.
# Nunca subas el service_role a un repo público.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Postgres (pooler)
DB_NAME=postgres
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DATABASE_URL_POOLER=postgresql://postgres.TU_PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
USE_SQLITE=false

# Storage — obligatorio en Vercel (todo /media va al bucket)
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=Mixlab
FORCE_SUPABASE_MEDIA=false

# Facturación electrónica DIAN (habilitación / SETP)
DIAN_ENVIRONMENT=HABILITACION
DIAN_SOFTWARE_ID=TU_ID_DEL_SOFTWARE
DIAN_SOFTWARE_PIN=TU_PIN
DIAN_TEST_PREFIX=SETP
DIAN_TEST_FROM=990000000
DIAN_TEST_TO=995000000
DIAN_TEST_TECHNICAL_KEY=fc8eac422eba16e22ffd8c6f94b3f40a6e38162c
# Certificado .p12 de firma (ruta local o base64 en serverless)
DIAN_CERTIFICATE_PATH=
DIAN_CERTIFICATE_PASSWORD=
# DIAN_CERTIFICATE_BASE64=
# Emitir FE automáticamente al registrar pago total
DIAN_AUTO_EMIT_ON_PAYMENT=false
# Habilitación SETP — resolución y set de pruebas
DIAN_RESOLUTION_NUMBER=18760000001
DIAN_RESOLUTION_FROM=2019-01-19
DIAN_RESOLUTION_TO=2030-01-19
# ID del set de pruebas (copiar del portal DIAN al crear el SETP)
DIAN_TEST_SET_ID=
DIAN_HAB_INVOICES=30
DIAN_HAB_CREDIT_NOTES=10
DIAN_HAB_DEBIT_NOTES=10
